{
  "name": "nutrilog-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "^8.10.0",
    "@shopify/react-native-skia": "^2.2.12",
    "@tanstack/react-query": "^5.100.8",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-barcode-scanner": "^13.0.1",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.1",
    "tailwindcss": "3.4.17",
    "victory-native": "^41.20.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-preset-expo": "^55.0.19",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.16",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "transform": {
      "^.+\\.tsx$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ],
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.ts",
      "^expo-notifications$": "<rootDir>/__mocks__/expo-notifications.ts",
      "^expo-device$": "<rootDir>/__mocks__/expo-device.ts",
      "^@react-native-community/netinfo$": "<rootDir>/__mocks__/netinfo.ts",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts",
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.ts",
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.ts",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.ts"
    }
  }
}
